{
  "name": "tommy-bahama-playwright-demo",
  "version": "1.0.0",
  "description": "Unofficial Playwright + TypeScript demo suite for the public Tommy Bahama website, with a GitHub Actions pipeline and a mobile app automation plan.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:mobile": "playwright test --project=mobile-chrome",
    "typecheck": "tsc -p .",
    "report": "playwright show-report"
  },
  "author": "Fahad Ahsan",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
